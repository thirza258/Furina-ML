# Base URL of the Furina ML Django API.
#
# Leave this unset for the normal setups:
#   * `npm run dev`  -> the app calls /api and Vite proxies it to :8000
#   * Docker         -> nginx serves the app and proxies /api to the backend
#
# Set it only for a split deployment where the API lives on another origin.
# Include the /api suffix.
# VITE_API_BASE_URL=https://api.example.com/api

# Where `npm run dev` should forward /api to, if Django is not on :8000.
# VITE_DEV_API_PROXY=http://localhost:8000
