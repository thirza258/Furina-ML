# Copy to `.env` and edit before deploying anywhere real:
#
#     cp .env.example .env
#
# Docker Compose reads this file automatically. Every variable is optional --
# `docker compose up` works without it -- but the two marked REQUIRED FOR
# PRODUCTION below ship with insecure defaults on purpose, so they are obvious.

# --- how you reach the app -------------------------------------------------
# Host port for the web UI: http://localhost:${APP_PORT}
APP_PORT=8080

# --- Django ----------------------------------------------------------------
# REQUIRED FOR PRODUCTION. Any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=insecure-compose-default-change-me

# Comma-separated hostnames Django will answer for. "*" is fine on a private
# network; name your domain once the app is public.
ALLOWED_HOSTS=*

# Needed once you serve over https: the origins Django trusts for POSTs to
# /admin/. Comma-separated, with the scheme.
# CSRF_TRUSTED_ORIGINS=https://furina.example.com

# Set when something in front of this terminates TLS, so Django stops believing
# every request arrived over plain http.
# USE_X_FORWARDED_PROTO=True

# Leave off. Turning it on serves tracebacks to the browser.
DJANGO_DEBUG=False

TIME_ZONE=UTC

# --- PostgreSQL ------------------------------------------------------------
# REQUIRED FOR PRODUCTION.
POSTGRES_DB=furinaml
POSTGRES_USER=furinaml
POSTGRES_PASSWORD=furinaml

# --- gunicorn --------------------------------------------------------------
# Each worker holds its own copy of pandas + scikit-learn, roughly 300MB.
# Raise the worker count for more concurrent training runs, not for speed:
# a single fit already uses every core it can.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
# Seconds a single request may take. Must be >= the frontend's 300s axios
# timeout and nginx's PROXY_TIMEOUT, or long training runs are cut off.
GUNICORN_TIMEOUT=300

# --- uploads and nginx -----------------------------------------------------
# Largest CSV that may be uploaded, in bytes. One number feeds both the Django
# check (core/ml/io.py) and nginx's client_max_body_size, so they cannot drift.
# 52428800 = 50MB.
MAX_UPLOAD_BYTES=52428800

PROXY_TIMEOUT=300s
# Where the SPA sends its API calls. Same origin unless you split the
# deployment; then use an absolute URL ending in /api.
API_BASE_URL=/api
# Where nginx proxies /api to. host:port, no scheme needed.
BACKEND_ORIGIN=backend:8000

# --- SEO -------------------------------------------------------------------
# The public origin this instance is served from. Rewrites the canonical link,
# the Open Graph URLs, the sitemap entries and robots.txt at container start.
SITE_URL=https://furina.nevatal.id

# --- in-app helper (optional) ----------------------------------------------
# An OpenRouter key switches on the "Ask for help" button. The key stays on the
# server -- the browser only ever calls /api/assistant/ -- so it is never in the
# JavaScript bundle. Leave it blank and the button explains that it is off.
#
# What is sent to OpenRouter when someone asks a question: the page they are on,
# their column names, types and missing-value counts, and the scores of their
# last run. Never the rows of their data.
# OPENROUTER_API_KEY=sk-or-v1-...
#
# Any model slug from https://openrouter.ai/models. The default is cheap with a
# large context; qwen/qwen3.7-flash, mistralai/mistral-nemo and
# google/gemini-2.5-flash are all reasonable for a short in-app helper.
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Per-IP ceiling on /api/assistant/. This app has no login, so on a public
# deployment this is the only thing between a shell loop and your bill.
ASSISTANT_RATE_LIMIT=20/hour

# --- optional admin login (created on first boot) --------------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=

# --- accounts --------------------------------------------------------------
# Anyone may create an account from the sign-up page. Set False to create
# accounts only through /admin/.
ACCOUNT_REGISTRATION=True
# Sign-in and sign-up attempts per client address.
AUTH_RATE_LIMIT=10/minute
# Proxies in front of Django that append to X-Forwarded-For. nginx is one;
# add one for each TLS terminator or load balancer in front of it.
NUM_PROXIES=1

# --- notebooks: "Open in Colab" (optional) -----------------------------------
# Lesson notebooks can also open in Google Colab, straight from GitHub. Only
# set this when the repository is public and contains the notebooks:
# NOTEBOOKS_GITHUB=thirza258/Furina-ML/blob/main/notebooks

# --- notebooks: one JupyterHub server per student (optional) ---------------
# Off by default. Without it, lesson notebooks still open in the in-browser
# JupyterLite preview at /notebooks/.
#
# The hub needs its own host name, and every student's server gets a
# subdomain of it (u12.notebooks.example.com): a wildcard DNS record, and
# behind TLS a wildcard certificate, for *.notebooks.example.com. That is what
# keeps one student's pages away from another's cookies. To try it locally,
# browsers resolve every *.localhost name to this machine:
#
#   SITE_URL=http://furina.localhost:8080
#   JUPYTERHUB_URL=http://notebooks.furina.localhost:8080
#
# Keep the hub a subdomain of SITE_URL's domain (same site), so the notebook
# can be embedded beside the lesson. Then set:
# COMPOSE_PROFILES=hub
# JUPYTERHUB_URL=https://notebooks.example.com
# JUPYTERHUB_OAUTH_CLIENT_ID=furina-jupyterhub
# REQUIRED with the hub. python -c "import secrets; print(secrets.token_urlsafe(32))"
# JUPYTERHUB_OAUTH_CLIENT_SECRET=
# REQUIRED with the hub. openssl rand -hex 32
# JUPYTERHUB_CRYPT_KEY=
#
# Per-student limits. Files persist in a volume per student; an idle server
# is stopped (its unsaved kernel state is lost, its files are not).
# NOTEBOOK_MEM_LIMIT=1G
# NOTEBOOK_CPU_LIMIT=1
# NOTEBOOK_PIDS_LIMIT=256
# NOTEBOOK_IDLE_SECONDS=1800

# --- notebooks: automated grading (optional) ---------------------------------
# Students hand in a lesson notebook; a grader worker re-runs the lesson's own
# checks on their exercise cells, in a throwaway container with no network.
# Works with or without the hub. Add "grader" to COMPOSE_PROFILES
# (e.g. COMPOSE_PROFILES=hub,grader) and set a shared secret:
# REQUIRED with the grader. openssl rand -hex 32
# GRADER_TOKEN=
# SUBMISSION_RATE_LIMIT=30/hour
# GRADER_CELL_TIMEOUT=60
# GRADER_TIMEOUT=300
# GRADER_MEM_LIMIT=1g
# GRADER_CPU_LIMIT=1
