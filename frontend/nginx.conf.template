# Furina ML frontend -- serves the built SPA and reverse-proxies the Django API
# so the whole app lives on a single origin (which is why CORS never applies).
#
# Rendered into /etc/nginx/conf.d/default.conf at container start by
# /docker-entrypoint.d/10-furina-config.sh, which substitutes the __NAMES__.
# When JUPYTERHUB_URL is set, the same script also renders
# nginx-jupyterhub.conf.template, a second server block for the hub's host.

# WebSocket upgrades for the JupyterHub server block: notebook kernels talk to
# the browser over a WebSocket. `map` is only allowed at this level.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    absolute_redirect off;

    # A literal `proxy_pass http://backend:8000` is resolved once, when the
    # config is parsed, and the address is then cached for the life of the
    # process -- so the first `docker compose up -d --build` that recreates the
    # backend on a new IP turns every API call into a 502 until nginx is
    # restarted too. Passing the host through a variable defers resolution to
    # each request, which is what makes the DNS TTL below matter.
    resolver __RESOLVER__ valid=10s ipv6=off;
    set $furina_backend "__BACKEND_ORIGIN__";

    set $forwarded_proto $scheme;
    if ($http_x_forwarded_proto != "") {
        set $forwarded_proto $http_x_forwarded_proto;
    }

    root /usr/share/nginx/html;
    index index.html;

    # Uploaded CSVs go through this proxy. nginx's stock 1m would 413 a real
    # dataset long before Django's own 50MB limit was reached.
    client_max_body_size __MAX_UPLOAD_SIZE__;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/xml image/svg+xml;

    # --- the API ---------------------------------------------------------
    # Host is forwarded with its port ($http_host, not $host). Django compares
    # a POST's Origin header with it, so on any port but 80/443 -- the default
    # :8080 included -- $host would fail every signed-in form and API call
    # with "Origin checking failed".
    location /api/ {
        proxy_pass http://$furina_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header Connection        "";

        # Fitting a model is one long synchronous request. The default 60s
        # read timeout would turn every non-trivial training run into a 504.
        proxy_connect_timeout 10s;
        proxy_send_timeout    __PROXY_TIMEOUT__;
        proxy_read_timeout    __PROXY_TIMEOUT__;

        # Model and report downloads stream straight through. Request
        # buffering stays on (the default) so nginx absorbs a slow 50MB upload
        # instead of holding a gunicorn thread open for its duration.
        proxy_buffering off;
    }

    # --- Django admin and its static assets ------------------------------
    location /admin {
        proxy_pass http://$furina_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header Connection        "";
        proxy_read_timeout __PROXY_TIMEOUT__;
    }

    # Django's own collected static files (admin, DRF). The SPA's assets live
    # under /assets/, so the two never collide.
    location /static/ {
        proxy_pass http://$furina_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host       $http_host;
        proxy_set_header Connection "";
    }

    # --- JupyterLite: the in-browser notebook preview -------------------
    # A static site built from notebooks/ into the image. Missing files have to
    # be real 404s -- JupyterLite probes for optional JSON files and cannot
    # parse the SPA's index.html -- and nothing here may be cached for long,
    # because several of its file names carry no content hash.
    location /notebooks/ {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }

    # --- the SPA ---------------------------------------------------------
    # Written at boot from $API_BASE_URL, so it must never be cached.
    location = /config.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Vite emits content-hashed filenames, so these are safe to pin forever.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # BrowserRouter: every unknown path is a client-side route, so a hard
    # refresh on /training has to be answered with index.html rather than 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
